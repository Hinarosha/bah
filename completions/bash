_arch_compgen() {
  local i r
  COMPREPLY=($(compgen -W '$*' -- "$cur"))
  for ((i = 1; i < ${#COMP_WORDS[@]} - 1; i++)); do
    for r in ${!COMPREPLY[@]}; do
      if [[ ${COMP_WORDS[i]} == ${COMPREPLY[r]} ]]; then
        unset 'COMPREPLY[r]'
        break
      fi
    done
  done
}

_arch_ptr2comp() {
  local list= x y
  for x; do
    for y in '0 --' '1 -'; do
      eval 'set -- ${'$x'[${y% *}]}'
      list+=\ ${@/#/${y#* }}
    done
  done
  _arch_compgen $list
}

_arch_incomp() {
  local r="[[:space:]]-(-${1#* }[[:space:]]|[[:alnum:]_]*${1% *})"
  [[ $COMP_LINE =~ $r ]]
}

_pacman_pkg() {
  _arch_compgen "$(
    if [[ $2 ]]; then
      \pacman -$1 2>/dev/null | \cut -d' ' -f1 | \sort -u
    else
      \pacman -$1 2>/dev/null
    fi
  )"
}

_bah_pkg() {
  [ -z "$cur" ] && _pacman_pkg Slq && return
  _arch_compgen "$(bah -Pc)"
}

_pacman_repo_list() {
  _arch_compgen "$(pacman-conf --repo-list)"$'\n'"$(bah -Sl --pkgbuilds | cut -d ' ' -f1 | uniq)"
}

_bah() {
  compopt -o default
  local common core cur database files prev query remove sync upgrade o
  local show getpkgbuild
  local cur prev words cword
  local verbs bah_implicit_search verb_handled

  _init_completion || return

  # Plain-word verbs: bah search … ≈ bah -Ss … (see src/subcommands.rs). First column TAB completes these plus pacman-style -S/-Q/…
  verbs='search find install remove uninstall rm query info build clone getpkgbuild fetch news stats order files database deptest repo repolist chroot clean list help version update upgrade sync up'
  if [[ $COMP_CWORD -eq 1 ]]; then
    if [[ $cur == -* ]]; then
      _arch_ptr2comp core
    else
      local tmp_reply
      _arch_compgen $verbs
      tmp_reply=("${COMPREPLY[@]}")
      _arch_ptr2comp core
      local i
      for i in "${tmp_reply[@]}"; do
        COMPREPLY+=("$i")
      done
    fi
    return 0
  fi

  bah_implicit_search=false
  verb_handled=false
  o=""
  if [[ $COMP_CWORD -ge 2 ]] && [[ ${COMP_WORDS[1]} != -* ]]; then
    verb_handled=true
    case ${COMP_WORDS[1]} in
      search | find)
        o='S sync'
        ;;
      install)
        o='S sync'
        ;;
      remove | uninstall | rm)
        o='R remove'
        ;;
      query)
        o='Q query'
        ;;
      info)
        o='S sync'
        ;;
      build)
        o='B build'
        ;;
      clone | getpkgbuild | fetch)
        o='G getpkgbuild'
        ;;
      news | stats | order)
        o='P show'
        ;;
      files)
        o='F files'
        ;;
      database)
        o='D database'
        ;;
      deptest)
        o='T deptest'
        ;;
      repo | repolist)
        o='L repoctl'
        ;;
      chroot)
        o='C chrootctl'
        ;;
      clean)
        o='S sync'
        ;;
      list)
        o='S sync'
        ;;
      help)
        _arch_ptr2comp core
        return 0
        ;;
      version)
        COMPREPLY=()
        return 0
        ;;
      update | upgrade | sync | up)
        o='S sync'
        ;;
      *)
        o='S sync'
        bah_implicit_search=true
        ;;
    esac
  fi

  if [[ $verb_handled != true ]]; then
    for o in 'D database' 'F files' 'Q query' 'R remove' 'S sync' 'U upgrade' 'P show' 'G getpkgbuild' 'C chrootctl' 'L repoctl'; do
      _arch_incomp "$o" && break
    done
  fi

  if [[ -z $o ]]; then
    _arch_ptr2comp core
    return 0
  fi
  database=('asdeps asexplicit')
  files=('list machinereadable refresh regex' 'l x y')
  query=('changelog check deps explicit file foreign groups info list native owns
          search unrequired upgrades' 'c e g i k l m n o p s t u')
  remove=('cascade dbonly nodeps assume-installed nosave print recursive unneeded local' 'c n p s u')
  sync=('asdeps asexplicit clean dbonly downloadonly overwrite groups ignore ignoregroup
         info list needed nodeps assume-installed print refresh recursive search sysupgrade'
    'c g i l p s u w y')
  upgrade=('asdeps asexplicit overwrite needed nodeps assume-installed print recursive install' 'p i')
  core=('database files help query remove sync upgrade version' 'D F Q R S U V h')

  common=('arch cachedir color config confirm dbpath debug gpgdir help hookdir logfile
           noconfirm noprogressbar noscriptlet quiet root verbose

           repo aur pkgbuilds mode aururl clonedir builddir makepkg mflags pacman pacman-conf git gitflags sudo sudoflags
           pkgctl gpg gpgflags fm fmflags chrootflags chrootpkgs rootchrootpkgs bat batflags pager completioninterval sortby searchby limit
           upgrademenu removemake noremovemake cleanafter nocleanafter rebuild norebuild
           redownload noredownload pgpfetch nopgpfetch useask
           nouseask savechanges nosavechanges failfast nofailfast keepsrc nokeepsrc combinedupgrade
           nocombinedupgrade batchinstall nobatchinstall provides noprovides devel nodevel
           develsuffixes ignoredevel sudoloop nosudoloop bottomup topdown newsonupgrade nonewsonupgrade
           chroot nochroot sign nosign keeprepocache nokeeprepocache signdb nosigndb
           localrepo nolocalrepo review skipreview interactive nocheck force-noscriptlet
           installdebug noinstalldebug noinstall optional' 'b d h q r v a')

  show=('news stats order' 'w s o')
  getpkgbuild=('print comments' 'p c')
  chrootctl=('sysupgrade install print' 'u i p')
  repoctl=('quiet list delete refresh clean' 'q l d y c')

  if [[ ! $prev =~ ^-[[:alnum:]_]*[Vbhr] && ! $prev == --@(cachedir|color|config|dbpath|help|hookdir|gpgdir|logfile|root|version) ]]; then
    [[ $cur == -* ]] && _arch_ptr2comp ${o#* } common ||
      case ${o% *} in
      D | R)
        _pacman_pkg Qq
        ;;
      F)
        { _arch_incomp 'l list' && _pacman_pkg Slq; } ||
          _arch_incomp 'o owns' ||
          compopt +o default
        ;;
      Q)
        { _arch_incomp 'g groups' && _pacman_pkg Qg sort; } ||
          { _arch_incomp 'p file' && _pacman_file; } ||
          { _arch_incomp 's search' && compopt +o default; } ||
          { _arch_incomp 'u upgrades' && compopt +o default; } ||
          _arch_incomp 'o owns' ||
          _pacman_pkg Qq
        ;;
      S)
        { _arch_incomp 'g groups' && _pacman_pkg Sg; } ||
          { [[ ${COMP_WORDS[1]} == list ]] && _pacman_repo_list; } ||
          { _arch_incomp 'l list' && _pacman_repo_list; } ||
          { _arch_incomp 's search' && compopt +o default; } ||
          { [[ ${COMP_WORDS[1]} == @(search|find) ]] && compopt +o default; } ||
          { [[ $bah_implicit_search == true ]] && compopt +o default; } ||
          { [[ ${COMP_WORDS[1]} == info ]] && _bah_pkg; } ||
          _bah_pkg
        ;;
      U)
        _pacman_file
        ;;
      G)
        _bah_pkg
        ;;
      P)
        [[ $cur == -* ]] && _arch_ptr2comp ${o#* } common || compopt +o default
        ;;
      L)
        [[ $cur == -* ]] && _arch_ptr2comp repoctl common || compopt +o default
        ;;
      C)
        [[ $cur == -* ]] && _arch_ptr2comp chrootctl common || compopt +o default
        ;;
      B)
        compopt +o filenames
        _filedir -d
        ;;
      T)
        [[ $cur == -* ]] && _arch_ptr2comp common || compopt +o default
        ;;
      esac
  fi
  true
}

_pacman_file() {
  compopt -o filenames
  _filedir 'pkg.tar*'
}

complete -F _bah bah

